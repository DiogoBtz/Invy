# Ambiente: development ou production
APP_ENV=development

# Gere uma chave forte antes de colocar em servidor.
# Exemplo PowerShell:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# SQLite local por padrao. Em servidor, voce pode trocar para PostgreSQL.
DATABASE_URL=sqlite:///invy.db

# Identidade visual white label.
APP_BRAND_NAME=Invy
APP_BRAND_CLIENT=Sua empresa
APP_BRAND_PRODUCT=Inventario de TI
APP_BRAND_TAGLINE=Inventario, garantias e notas fiscais em uma rotina so.
APP_BRAND_LOGO_PATH=
APP_BRAND_ACCENT=#2563eb
APP_BRAND_ACCENT_ALT=#14b8a6
APP_COMPANY_OPTIONS=Empresa Principal,Filial 1,Filial 2

# Servidor WSGI
# A porta/host ficam no comando do Waitress/Gunicorn, nao no Flask.
# Exemplo: waitress-serve --listen=0.0.0.0:8000 Main:app
APP_DEBUG=false
TEMPLATES_AUTO_RELOAD=true

# Reverse proxy Apache/IIS/Nginx: deixe false quando acessar o Waitress direto.
# Ative apenas quando o proxy for confiavel e enviar X-Forwarded-*.
TRUST_PROXY_HEADERS=false
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1
PROXY_FIX_X_PREFIX=1

# Cookies: em HTTPS no servidor, deixe true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=480

# Protecao simples contra forca bruta no login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Protege formularios POST contra CSRF. Mantenha true.
CSRF_PROTECT=true

# Dominios permitidos para usuarios locais do sistema.
# Deixe vazio para aceitar qualquer e-mail valido.
# Exemplo: ALLOWED_USER_EMAIL_DOMAINS=empresa.com.br,grupo.com.br
ALLOWED_USER_EMAIL_DOMAINS=

# Usuario mestre criado somente se ainda nao existir.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_FULL_NAME=Administrador Invy
ADMIN_PASSWORD=troque-esta-senha-forte

# Codigo exigido para criar/promover outro administrador pela tela Usuarios.
# Guarde apenas no servidor. Gere um valor forte com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_ADMIN_CODE=troque-este-codigo-master

# Pastas de upload. Normalmente nao precisa alterar.
# UPLOAD_FOLDER=C:\invy\static\uploads
# HISTORY_FOLDER=C:\invy\static\history_uploads
# INVOICE_UPLOAD_FOLDER=C:\invy\static\invoice_uploads
# IMPORT_PREVIEW_FOLDER=C:\invy\instance\import_previews
IMPORT_PREVIEW_TTL_SECONDS=1800
MAX_IMPORT_ROWS=5000
MAX_NF_PDF_PAGES=25
MAX_NF_PDF_TEXT_CHARS=200000

# Dell TechDirect Warranty API.
# Deixe false ate receber Client ID e Secret da Dell.
DELL_API_ENABLED=false
DELL_API_CLIENT_ID=
DELL_API_CLIENT_SECRET=
DELL_API_TOKEN_URL=https://apigtwb2c.us.dell.com/auth/oauth/v2/token
DELL_API_WARRANTY_URL=https://apigtwb2c.us.dell.com/PROD/sbil/eapi/v5/asset-entitlements
DELL_API_TIMEOUT_SECONDS=8
DELL_WARRANTY_EXPIRING_DAYS=30

# Microsoft Graph - sincronizacao de colaboradores do Microsoft 365.
# Crie um App Registration no Microsoft Entra ID e conceda Admin consent.
# Permissoes Application recomendadas: User.Read.All, Directory.Read.All,
# LicenseAssignment.Read.All.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MS_GRAPH_TIMEOUT_SECONDS=15
MS_AZURE_MANAGEMENT_BASE_URL=https://management.azure.com
MS_BILLING_ACCOUNT_NAME=
MS_BILLING_PROFILE_NAME=
MS_COST_MANAGEMENT_API_VERSION=2025-03-01
MS_BILLING_API_VERSION=2024-04-01

# DocuSign - assinatura digital.
# Desligado por padrao; preencha somente quando for integrar.
DOCUSIGN_ENABLED=false
DOCUSIGN_WEBHOOK_ENABLED=false
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_WEBHOOK_SECRET=
DOCUSIGN_RETURN_URL=
DOCUSIGN_TIMEOUT_SECONDS=15
DOCUSIGN_AUTO_SYNC_ENABLED=true
DOCUSIGN_AUTO_SYNC_MINUTES=10
DOCUSIGN_AUTO_SYNC_LIMIT=50
RESPONSIBILITY_TERM_TEMPLATE_PATH=docs\Termo em Branco.docx
RETURN_TERM_TEMPLATE_PATH=Termo Devoulução\Termo de Devolução.docx
RESPONSIBILITY_SIGNED_TERMS_DIR=Termos Assinados

# Licenciamento / painel do dono do projeto.
# Na VPS do dono, deixe INVY_OWNER_PANEL_ENABLED=true e gere INVY_LICENSE_API_TOKEN.
# No cliente, preencha URL, token e chave da licenca.
INVY_OWNER_PANEL_ENABLED=false
INVY_LICENSE_API_TOKEN=
INVY_LICENSE_API_URL=
INVY_LICENSE_KEY=
INVY_LICENSE_REQUIRED=false
INVY_LICENSE_CACHE_MINUTES=10
INVY_LICENSE_GRACE_HOURS=24
INVY_UPDATE_CACHE_MINUTES=10
INVY_ENFORCE_MANDATORY_UPDATE=true
INVY_SUPPORT_PHONE=
INVY_SUPPORT_EMAIL=
# Opcional para testes. Em cliente real, deixe vazio para usar a versao do executavel.
INVY_APP_VERSION_OVERRIDE=

# Backup automatico do banco SQLite.
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_TIME=15:00
DATABASE_BACKUP_DIR=Backups Banco
BACKUP_RETENTION_COUNT=30
BACKUP_RETENTION_DAYS=90
